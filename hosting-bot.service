[Unit]
Description=Telegram Hosting Bot
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/host
ExecStart=/home/ubuntu/host/venv/bin/python /home/ubuntu/host/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
