# ============================================================================
# Hosting Bot - Environment Configuration Template
# Copy to `.env` and fill in your real values:  cp .env.example .env
# NOTE: `.env` is git-ignored. Never commit real credentials here.
# `*` = required (app fails to start if missing).
# ============================================================================

BOT_TOKEN=your-bot-token-here
API_ID=your-api-id
API_HASH=your-api-hash

OWNER_ID=your-telegram-user-id
ADMIN_IDS=your-telegram-user-id
# Admin dashboard login (username + password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
YOUR_USERNAME=@yourusername
UPDATE_CHANNEL=https://t.me/yourchannel

# --- Firebase Admin SDK (Google sign-in on the dashboard) ---
# Path to the downloaded firebase-adminsdk service-account JSON file.
# e.g. ./firebase-adminsdk.json  OR the full JSON as a single line.
# Needed because the server verifies Google auth tokens with the Admin SDK.
FIREBASE_CREDENTIALS=./firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DATABASE_URL=
# Firebase Web SDK config (for the client-side Google sign-in popup).
# Get these from your Firebase console -> Project settings -> Web app.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# --- GitHub OAuth (GitHub sign-in + deploy-from-GitHub on the dashboard) ---
# Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL must be:  <WEB_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional, defaults to <WEB_URL>/auth/github/callback
GITHUB_REDIRECT_URI=

# --- Web dashboard ---
# Public URL of the dashboard (VPS). Must match the port in dashboard.service (9090).
WEB_URL=http://your-vps-ip:9090

# --- AI /mpx (optional) ---
A4F_API_URL=
A4F_API_KEY=
A4F_MODEL=

# --- Cloudflare R2 (required) ---
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=hosting
R2_REGION=auto

# --- MongoDB (required) ---
MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/
MONGO_DB_NAME=host_bot

# --- Encryption ---
# Fernet key for encrypting hosted-bot env vars.
# Generate with: python -c "from security import generate_key; print(generate_key())"
# Keep it stable across restarts or already-encrypted vars become undecryptable.
ENV_ENCRYPTION_KEY=run-setup-vps-to-generate

# --- Limits ---
MAX_UPLOAD_MB=100
MAX_MEMORY=512m
MAX_CPUS=1
MAX_PIDS=128
MAX_BOTS_PER_USER=5
FREE_USER_LIMIT=2
SUBSCRIBED_USER_LIMIT=15

# --- Auto-heal (new) ---
# Seconds to watch a newly started bot for a missing pip/npm module and
# auto-install + restart it in the background. 0 disables auto-heal.
AUTO_HEAL_WINDOW=120
