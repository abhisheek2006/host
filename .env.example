BOT_TOKEN=your-bot-token-here
API_ID=your-api-id
API_HASH=your-api-hash

OWNER_ID=your-telegram-user-id
ADMIN_IDS=your-id,another-admin-id
YOUR_USERNAME=@your-username
UPDATE_CHANNEL=https://t.me/yourchannel

# Web dashboard URL (shown to users when they request a login code)
WEB_URL=http://your-vps-ip:8000

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=hosting
R2_REGION=auto

MONGO_URI=your-mongodb-connection-string
MONGO_DB_NAME=hostbot

ENV_ENCRYPTION_KEY=run-setup-vps-to-generate

MAX_UPLOAD_MB=100
MAX_MEMORY=512m
MAX_CPUS=1
MAX_PIDS=128

FREE_USER_LIMIT=2
SUBSCRIBED_USER_LIMIT=15

A4F_API_URL=https://api.example.com/v1/chat/completions
A4F_API_KEY=your-api-key
A4F_MODEL=your-model-name
