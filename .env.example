# ============================================================================
# Hosting Bot - Environment Configuration Template
# Copy to `.env` and fill in your real values:  cp .env.example .env
# NOTE: `.env` is git-ignored. Never commit real credentials.
# `*` = required (app fails to start if missing).
# ============================================================================

# --- Telegram (required) ---
BOT_TOKEN=123456789:AAE-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX     # * from BotFather
API_ID=1234567                                                # * api id, my.telegram.org
API_HASH=0123456789abcdef0123456789abcdef                     # * api hash

# --- Access control ---
OWNER_ID=0                                                    # main owner telegram id
ADMIN_IDS=0                                                   # comma-separated extra admin ids
YOUR_USERNAME=@yourhandle                                     # your @username
UPDATE_CHANNEL=https://t.me/yourchannel                        # channel users are asked to join

# --- Web dashboard ---
# Public URL of the dashboard (VPS). Must match the port in dashboard.service (9090).
WEB_URL=http://13.60.45.38:9090

# --- AI /mpx (optional) ---
A4F_API_URL=
A4F_API_KEY=
A4F_MODEL=

# --- Cloudflare R2 (required) ---
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com         # * S3 endpoint
R2_ACCESS_KEY_ID=your_r2_access_key                            # *
R2_SECRET_ACCESS_KEY=your_r2_secret_key                        # *
R2_BUCKET=hosting
R2_REGION=auto

# --- MongoDB (required) ---
MONGO_URI=mongodb+srv://user:pass@cluster0.mongodb.net/        # * connection string
MONGO_DB_NAME=host_bot

# --- Encryption ---
# Fernet key for encrypting hosted-bot env vars.
# Generate with: python -c "from security import generate_key; print(generate_key())"
# Keep it stable across restarts or already-encrypted vars become undecryptable.
ENV_ENCRYPTION_KEY=

# --- Limits ---
MAX_UPLOAD_MB=100
MAX_MEMORY=512m
MAX_CPUS=1
MAX_PIDS=128
MAX_BOTS_PER_USER=5
FREE_USER_LIMIT=5
SUBSCRIBED_USER_LIMIT=15

# --- Auto-heal (new) ---
# Seconds to watch a newly started bot for a missing pip/npm module and
# auto-install + restart it in the background. 0 disables auto-heal.
AUTO_HEAL_WINDOW=120
