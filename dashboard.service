[Unit]
Description=HostBot Web Dashboard
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/host
Environment=DASHBOARD_PORT=9090
Environment=DASHBOARD_HOST=0.0.0.0
Environment=WEB_URL=http://13.60.45.38:9090
ExecStart=/home/ubuntu/host/venv/bin/python /home/ubuntu/host/web_dashboard.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
